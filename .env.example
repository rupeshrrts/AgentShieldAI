# AgentShield Environment Configuration

# Backend
SECRET_KEY=agentshield-super-secret-production-key-change-me-321
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default uses local SQLite agentshield.db for instant zero-dependency run; or PostgreSQL in Docker)
DATABASE_URL=sqlite:///./agentshield.db
# DATABASE_URL=postgresql://agentshield:AgentShieldDbPass2026!@localhost:5432/agentshield_poc

# PostgreSQL container config
POSTGRES_USER=agentshield
POSTGRES_PASSWORD=AgentShieldDbPass2026!
POSTGRES_DB=agentshield_poc
