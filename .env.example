# AgentShield Environment Configuration (local development; production settings: DEPLOY_STEPS.md)

# Backend. Leave SECRET_KEY empty in development (a random key is used per run); production needs a strong one:
# python scripts/generate_secret_key.py
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database: local SQLite by default; for Supabase / PostgreSQL use its connection string
DATABASE_URL=sqlite:///./agentshield.db
