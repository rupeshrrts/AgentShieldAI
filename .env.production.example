# ==============================================================================
# AgentShield AI - Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the production deployment:
# cp .env.production.example .env
#
# IMPORTANT: Never commit your actual .env file or production secrets to Git!
# ==============================================================================

# Application Environment
ENVIRONMENT=production
PROJECT_NAME=AgentShield Security & Governance API
VERSION=1.0.0

# ------------------------------------------------------------------------------
# Backend Security & JWT
# ------------------------------------------------------------------------------
# Generate a strong 64-character secret with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_SECURE_64_CHAR_HEX_SECRET_FOR_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ------------------------------------------------------------------------------
# Optional: a first customer company and its admin (created on first boot only,
# and only when both values are set). Leave empty for a pure SaaS setup where
# customers sign up themselves. There are no built-in credentials.
# ------------------------------------------------------------------------------
INITIAL_ORG_NAME=Your Company Name
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# Customer portal sign-up
# ------------------------------------------------------------------------------
# Individual accounts: public sign-up on/off
SIGNUP_ENABLED=true
# Company workspaces are "coming soon": keep false until company onboarding ships
COMPANY_SIGNUP_ENABLED=false
# Free trial length (days); the trial starts only after the email is confirmed
TRIAL_DAYS=30
# false: Free plan and trial right after sign-up (no confirmation email). true: confirm email first.
EMAIL_VERIFICATION_REQUIRED=false
# Browsers an account may connect while it runs on prepaid credits only
CREDITS_DEVICE_LIMIT=3
# Address of the customer portal (used in confirmation and reset links)
DASHBOARD_URL=https://portal.yourdomain.com

# ------------------------------------------------------------------------------
# Internal admin console (AgentShieldAI staff). Create the first platform owner
# after deploying:  python -m app.cli create-platform-owner --email you@company.com
# ------------------------------------------------------------------------------
# HTTPS address of the internal console (used in staff invite links). Host it on
# its own address and add it to ALLOWED_ORIGINS.
ADMIN_CONSOLE_URL=https://admin.yourdomain.com
# Encrypts staff authenticator secrets at rest. Generate like SECRET_KEY; if empty,
# a key is derived from SECRET_KEY (then rotating SECRET_KEY forces MFA re-enrolment).
STAFF_MFA_KEY=
# Staff session length in hours
STAFF_TOKEN_HOURS=8

# Maximum audit events per employee per device key per minute
DEVICE_EVENTS_PER_MINUTE=120

# ------------------------------------------------------------------------------
# Extension distribution (see INSTALL.md)
# ------------------------------------------------------------------------------
# HTTPS address employee PCs use to reach this server (used for extension updates)
PUBLIC_BASE_URL=https://agentshield.yourcompany.com
# Fill in only after publishing to the Chrome Web Store / Edge Add-ons
CHROME_STORE_EXTENSION_ID=
EDGE_STORE_EXTENSION_ID=
# true only on a demo server (shows the Guided Demo page)
DEMO_MODE=false

# ------------------------------------------------------------------------------
# Online payments - Razorpay (optional; see INSTALL.md 1.7). Leave the keys empty
# to keep payments off (plans are then granted by the platform operator).
# Use rzp_test_ keys first (test mode, no real money), then rzp_live_ keys.
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set on the webhook https://<your-server>/api/v1/billing/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=
# Printed on payment receipts
BILLING_SELLER_NAME=AgentShield
BILLING_SELLER_DETAILS=

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Production PostgreSQL or Supabase Connection String:
# Session Mode (Direct): postgresql://postgres.PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
# Transaction Mode (PgBouncer): postgresql://postgres.PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://agentshield:CHANGE_THIS_DB_PASSWORD@db:5432/agentshield_poc

# If using local Docker Postgres:
POSTGRES_USER=agentshield
POSTGRES_PASSWORD=CHANGE_THIS_DB_PASSWORD
POSTGRES_DB=agentshield_poc

# ------------------------------------------------------------------------------
# CORS & Networking
# ------------------------------------------------------------------------------
# Comma-separated list of dashboard origins allowed to call the API. Do not use "*".
# (The browser extension does not need an entry here.)
ALLOWED_ORIGINS=https://dashboard.yourdomain.com,https://admin.yourdomain.com

# ------------------------------------------------------------------------------
# Dashboard Frontend
# ------------------------------------------------------------------------------
# In production with reverse proxy, set to empty string "" or your API domain:
VITE_API_BASE_URL=https://api.yourdomain.com

# Free plan and referrals (2.3)
FREE_TIER_ENABLED=true
REFERRAL_BONUS_CHECKS=100
REFERRAL_MAX=10
