# AgentShield React Dashboard Environment Variables
# In production, specify the full URL of your backend API if deployed on a different domain:
# VITE_API_BASE_URL=https://api.yourdomain.com
#
# If deployed on the same domain or behind NGINX reverse proxy, leave blank:
VITE_API_BASE_URL=
#
# The internal staff console, linked as "Site owner? Admin login" on the sign-in page (required on Vercel).
# VITE_ADMIN_CONSOLE_URL=https://admin.yourdomain.com
